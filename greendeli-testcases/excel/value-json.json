      "errorMessage": "Employee name is required"
    }
  },
  {
    "testId": "TC_004",
    "testName": "Validation Error - Invalid Mobile Number",
    "testType": "negative",
    "formData": {
      "employeeCode": "EMP1004",
      "employeeName": "Sara Smith",
